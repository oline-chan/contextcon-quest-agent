# Copy to .env and fill in your own values. NEVER commit .env.
# No real wallet, no real funds — testnet / demo only.

# Meko Cloud (free): https://cloud.mekodata.ai
# 1. Create a free account, create a datapack named "contextcon-quest-agent".
# 2. Settings > API Keys > Generate API key (starts with mko_tkn_).
# 3. Paste the full key here. Without it, the app runs in local-demo mode.
MEKO_API_KEY=
# Optional: the datapack id from the Meko portal. Empty = default datapack.
MEKO_DATAPACK_ID=
# MCP endpoint (same for every account/datapack, per Meko docs).
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_AGENT_ID=quest-agent
